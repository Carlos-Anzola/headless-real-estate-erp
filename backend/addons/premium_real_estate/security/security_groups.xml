<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Categoría de la Aplicación -->
    <record model="ir.module.category" id="module_category_premium_real_estate">
        <field name="name">Real Estate</field>
        <field name="description">Gestión de propiedades y asesores.</field>
        <field name="sequence">10</field>
    </record>

    <!-- 2. Grupo: Asesor -->
    <record id="group_real_estate_asesor" model="res.groups">
        <field name="name">Asesor</field>
        <field name="category_id" ref="module_category_premium_real_estate"/>
    </record>

    <!-- 3. Grupo: Administrador -->
    <record id="group_real_estate_admin" model="res.groups">
        <field name="name">Administrador</field>
        <field name="category_id" ref="module_category_premium_real_estate"/>
        <field name="implied_ids" eval="[(4, ref('group_real_estate_asesor'))]"/>
        <!-- Este comando te asigna el rol automáticamente al instalar -->
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/> 
    </record>

    <!-- 4. Regla: El Asesor SOLO ve y edita sus propias propiedades -->
    <record id="rule_property_asesor" model="ir.rule">
        <field name="name">Propiedades del Asesor</field>
        <field name="model_id" ref="model_premium_property"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_real_estate_asesor'))]"/>
    </record>

    <!-- 5. Regla: El Administrador ve TODAS las propiedades -->
    <record id="rule_property_admin" model="ir.rule">
        <field name="name">Propiedades del Administrador</field>
        <field name="model_id" ref="model_premium_property"/>
        <!-- (1, '=', 1) significa "Sin filtros, trae todo" -->
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_real_estate_admin'))]"/>
    </record>
</odoo>